// Shared build settings for every target.
//
// Don't edit these to set up signing — copy Config/Local.xcconfig.example to
// Config/Local.xcconfig and put your own values there (it's git-ignored).

// Bundle IDs must be unique across all Apple accounts, so change this to
// something that's yours (e.g. com.yourname) in Local.xcconfig.
BUNDLE_ID_PREFIX = io.github.niyatapp

// Shared storage between the app and its widgets/extensions.
APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).niyat

// Your Apple team ID. Set it in Local.xcconfig.
DEVELOPMENT_TEAM =

// After the app is on the App Store: its numeric Apple ID (App Store Connect ›
// App Information), used by More › Rate Niyat. Leave empty until then.
APP_STORE_ID = 6816590077

// Where More › Send feedback emails go. Empty = open a GitHub issue instead.
// Tip: use a separate address rather than a personal one, because it ships in the app.
FEEDBACK_EMAIL =

// Discord webhook for More › Send feedback. Set it in Local.xcconfig (never
// here: this file is public). Leave out "https://", e.g.
// DISCORD_WEBHOOK = discord.com/api/webhooks/123456/abcdef
DISCORD_WEBHOOK =

// The recitation check's server and key (see server/README.md). Set them in
// Local.xcconfig, never here. Without them the check is hidden. Leave out
// "https://", e.g.
// RECITATION_SERVER = 203-0-113-7.sslip.io
// RECITATION_KEY = <the NIYAT_APP_KEYS value on the server>
RECITATION_SERVER =
RECITATION_KEY =

#include? "Local.xcconfig"
