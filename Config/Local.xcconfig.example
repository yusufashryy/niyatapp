// Copy this file to Config/Local.xcconfig and fill it in.
// Local.xcconfig is git-ignored, so your team ID stays out of the repo.

// Find it in Xcode > Settings > Accounts > (your Apple ID) > team, or at
// https://developer.apple.com/account under "Membership details".
DEVELOPMENT_TEAM = ABCDE12345

// Anything unique that you own, in reverse-domain style.
BUNDLE_ID_PREFIX = com.yourname

// Optional: where More › Send feedback emails go (otherwise it opens a GitHub issue).
// FEEDBACK_EMAIL = feedback@example.com

// Optional: send More › Send feedback to a Discord channel. Server Settings ›
// Integrations › Webhooks › New Webhook › Copy URL, then paste it here WITHOUT "https://".
// DISCORD_WEBHOOK = discord.com/api/webhooks/123456/abcdef
