# Copy to .env (git-ignored) and fill in.

# The address the app connects to. Without a domain of your own, use your
# server's IP address with dashes and .sslip.io, e.g. 203-0-113-7.sslip.io
NIYAT_DOMAIN=203-0-113-7.sslip.io

# The key the app sends. Make one with:  openssl rand -base64 32
# Put the same value in the app's Config/Local.xcconfig as RECITATION_KEY.
NIYAT_APP_KEYS=

# Optional:
# NIYAT_CONCURRENCY=1      recordings checked at once (2 needs about 6 GB of memory)
# NIYAT_PER_MINUTE=30      recordings per minute from one address
# NIYAT_MAX_SECONDS=45     longest recording
# NIYAT_THREADS=0          CPU threads (0: all)
